<?xml version="1.0"?>
<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">
  <name>meridian_clip</name>
  <version>0.0.2</version>

  <description>
    Meridian Perception Frontend: CLIP ViT-B/32 semantic embedding
  </description>

  <maintainer email="sojin@example.com">
    sojin
  </maintainer>

  <license>Apache-2.0</license>

  <!-- Build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 package dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>cv_bridge</depend>
  <depend>meridian_msgs</depend>
  <depend>vision_msgs</depend>

  <!-- Runtime dependencies -->
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <!-- build_regions 가 ndimage.find_objects 로 모든 라벨의 bbox 를 한 번에 얻는다 -->
  <exec_depend>python3-scipy</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
